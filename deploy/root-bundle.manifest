# Lista de archivos que el sync instala fuera del checkout: scripts en
# /usr/local/sbin/, unidades en /etc/systemd/system/ y artefactos servidos por
# Nginx en /var/www/.

# Cada entrada son 4 campos separados por espacios: origen (ruta en deploy/),
# destino final, modo octal y dueno (usuario:grupo). Una linea con mas de 4
# campos se rechaza: casi siempre es un origen con un espacio. Un archivo nuevo
# no entra por existir solo: hay que agregarlo aca.

# Scripts de deploy
deploy/deploy.sh                                                         /usr/local/sbin/webcmp-deploy                               0755    root:root
deploy/autodeploy.sh                                                     /usr/local/sbin/webcmp-autodeploy                          0755    root:root
deploy/apply-env.sh                                                      /usr/local/sbin/webcmp-apply-env                           0755    root:root
# El helper entra en la lista: sin esta linea el sync no puede actualizarse a
# si mismo y un arreglo suyo quedaria solo en el checkout. Es seguro: bash ya
# leyo el archivo a memoria y el mv -T del install es atomico.
deploy/webcmp-deploy-sync.sh                                             /usr/local/sbin/webcmp-deploy-sync.sh                      0755    root:root

# Unidades systemd
deploy/systemd/webcmp.service                                            /etc/systemd/system/webcmp.service                          0644    root:root
deploy/systemd/webcmp-huey.service                                        /etc/systemd/system/webcmp-huey.service                     0644    root:root
deploy/systemd/webcmp-apply.service                                       /etc/systemd/system/webcmp-apply.service                    0644    root:root
deploy/systemd/webcmp-apply.path                                          /etc/systemd/system/webcmp-apply.path                       0644    root:root
deploy/systemd/webcmp-autodeploy.service                                  /etc/systemd/system/webcmp-autodeploy.service               0644    root:root
deploy/systemd/webcmp-autodeploy.path                                     /etc/systemd/system/webcmp-autodeploy.path                  0644    root:root
deploy/systemd/webcmp-backup.service                                      /etc/systemd/system/webcmp-backup.service                   0644    root:root
deploy/systemd/webcmp-backup.timer                                        /etc/systemd/system/webcmp-backup.timer                     0644    root:root

# Pagina de error de Nginx (502/503/504)
# La sirve el vhost con error_page; install.sh la escribe en una instalacion
# nueva y este sync la mantiene al dia en cada deploy.
deploy/nginx/50x.html                                                    /var/www/webcmp-errors/50x.html                             0644    root:root

# Sync de artefactos root
deploy/systemd/webcmp-sync.service                                        /etc/systemd/system/webcmp-sync.service                     0644    root:root
deploy/systemd/webcmp-sync.timer                                          /etc/systemd/system/webcmp-sync.timer                         0644    root:root
