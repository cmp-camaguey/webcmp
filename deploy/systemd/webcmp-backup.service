[Unit]
Description=Respaldo diario de la base de webcmp
Documentation=file:/srv/webcmp/deploy/README-deploy.md

[Service]
Type=oneshot
# root, y solo por dos cosas: leer /etc/webcmp/deploy.env y escribir en
# DB_BACKUP_DIR (0700 root:root). El script no acepta argumentos y no hace nada
# mas que volcar la base y rotar los respaldos viejos.
User=root
Group=root
# El respaldo completo lo hace `webcmp-deploy --backup`, el mismo ejecutable y
# la misma implementacion que el dump previo a migrar. Instalarlo aparte seria
# una segunda copia que se desincroniza sin que nada falle.
ExecStart=/usr/local/sbin/webcmp-deploy --backup
# Un pg_dump de una base de este tamano tarda segundos. El tope evita que una
# base bloqueada deje la unidad "activating" hasta el timeout de systemd sin
# que nadie sepa por que no hay respaldo del dia.
TimeoutStartSec=1800
ProtectSystem=full
ProtectHome=yes
# Sin PrivateTmp a proposito. `db_dump` corre el dump con `systemd-run`, y una
# unidad transitoria NO hereda este namespace: escribe su stderr en el /tmp real
# mientras este proceso lo busca en el privado. El resultado seria perder el
# motivo de un pg_dump fallido, que es justo el texto que hace falta a las 03:15.
NoNewPrivileges=yes
